# Repuven — Apache / cPanel settings for the member site

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# https, and always www.repuven.com (one address keeps everyone signed in).
# Any other domain pointed here just gets https and stays on its own address.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^repuven\.com$ [NC]
  RewriteRule ^ https://www.repuven.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # pages always fresh, files cached for 10 minutes
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|webp|jpg)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain
</IfModule>

# never serve project files that are not part of the site
<FilesMatch "^(_headers|vercel\.json)$">
  Require all denied
</FilesMatch>
